{
  "name": "coduo-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:run": "vitest run",
    "template": "vite build && node scripts/generate-languages.mjs && node -e \"const fs=require('fs');fs.copyFileSync('dist/index.html','../skills/create-code-viewer/assets/template.html')\""
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^28.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.11"
  }
}